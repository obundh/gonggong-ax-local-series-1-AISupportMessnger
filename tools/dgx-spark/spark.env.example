# Heyu DGX Spark runtime profile.
# The original app/config/llm.json remains unchanged. These values are used
# only by tools/dgx-spark/start-heyu-spark.sh.

HEYU_SPARK_MODEL_SIZE=31b

HEYU_LLM_PROVIDER=ollama
HEYU_LLM_BASE_URL=http://127.0.0.1:11434

# Ollama models are mapped by tag, not by filesystem path.
# If these tags do not exist, the launcher checks `ollama list`, chooses a
# matching Gemma tag, and saves the resolved tag back into tools/dgx-spark/spark.env.
HEYU_LLM_MODEL_31B=gemma4:31b
HEYU_LLM_MODEL_26B=gemma4:26b
HEYU_LLM_MODEL_AUTODETECT=1

HEYU_LLM_NUM_CTX_31B=8192
HEYU_LLM_NUM_CTX_26B=8192
HEYU_LLM_TIMEOUT_MS=900000
HEYU_LLM_TEMPERATURE=0.25
HEYU_LLM_TOP_P=0.9

HEYU_STT_ENABLE_LARGE_MODELS=1
HEYU_EMP_DATA_MODE=full

# Leave blank to use the package-local workspace.
HEYU_WORKSPACE_DIR=
